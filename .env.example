# 이 파일만 Git에 올립니다. 실제 값은 .env.local(로컬) / Vercel 환경변수(배포)에 넣으세요.
# 복사: cp .env.example .env.local

# --- 필수(크론·텔레그램 알림) ---
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 선택: 수동 /api/alert 전송 허용 ---
# TELEGRAM_ALERT_ENABLED=true

# --- 선택: 스캔 알림 끄기 ---
# TELEGRAM_SCAN_ALERTS=false

# --- 선택: 스캐너·알림 튜닝 ---
# SCANNER_MIN_REVERSAL_DISPLAY_SCORE=40
# SCANNER_DASHBOARD_TOP_N=20
# SCANNER_STRATEGY_RESULT_CAP=50
# SCAN_ALERT_MIN_REVERSAL_SCORE=48
# SCANNER_QUOTE_CHUNK_SIZE=80
# SCANNER_CANDLE_CONCURRENCY=10

# --- 선택: 국내 KIS / 유니버스 (사용할 때만) ---
# DOMESTIC_DATA_SOURCE=kis
# KIS_APP_KEY=
# KIS_APP_SECRET=
# SCANNER_DOMESTIC_SYMBOLS=
# SCANNER_DOMESTIC_UNIVERSE_PATH=

# --- 로컬 전용( Vercel에서는 보통 끔 ) ---
# ENABLE_SCAN_ALERT_LOOP=true
